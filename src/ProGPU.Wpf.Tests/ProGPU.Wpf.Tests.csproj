<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\external\ProGPU\eng\ProGPU.snk</AssemblyOriginatorKeyFile>
    <!-- This focused graph reaches the same ProGPU shim projects through
         multiple compatibility roots that share output directories. Serial
         project-reference scheduling avoids parallel output-lock contention
         without removing any compiler, analyzer, or test coverage. -->
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="System.CodeDom" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../samples/ProGPU.Wpf.ShowcaseApp/PassiveIdleInterval.cs" Link="Showcase/PassiveIdleInterval.cs" />
    <Compile Include="../ProGPU.Wpf.MultiWindowSmokeHarness/GlyphComputeReadback.cs" Link="MultiWindow/GlyphComputeReadback.cs" />
    <Compile Include="../../samples/ProGPU.Wpf.ShowcaseApp/PassiveIdleStartup.cs" Link="Showcase/PassiveIdleStartup.cs" />
    <Compile Include="../../samples/ProGPU.Wpf.ShowcaseApp/PassiveIdleBoundary.cs" Link="Showcase/PassiveIdleBoundary.cs" />
    <Compile Include="../../samples/ProGPU.Wpf.ShowcaseApp/NativeResizePresentation.cs" Link="Showcase/NativeResizePresentation.cs" />
    <Compile Include="../../samples/ProGPU.Wpf.ShowcaseApp/PassiveIdlePhaseJournal.cs" Link="Showcase/PassiveIdlePhaseJournal.cs" />
    <Compile Include="../../samples/ProGPU.Wpf.ShowcaseApp/MenuLifecycleJournal.cs" Link="Showcase/MenuLifecycleJournal.cs" />
    <Compile Include="../../samples/ProGPU.Wpf.ShowcaseApp/NativeDragInputReceipt.cs" Link="Showcase/NativeDragInputReceipt.cs" />
    <ProjectReference Include="..\Microsoft.DotNet.Wpf\src\Microsoft.Win32.SystemEvents\Microsoft.Win32.SystemEvents.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\ProGPU.Compatibility\WindowsBase\WindowsBase.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\ProGPU.Compatibility\PresentationCore\PresentationCore.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\src\ProGPU.Wpf.Interop\ProGPU.Wpf.Interop.csproj" />
    <ProjectReference Include="$(LibreWinFormsSourceRoot)src/ProGPU.Drawing/System.Drawing.Common/System.Drawing.Common.csproj" AdditionalProperties="ProGpuSourceRoot=$(ProGpuSourceRoot)" PrivateAssets="all" />
    <ProjectReference Include="..\LibreWPF.WinFormsCompat\System.Windows.Forms\System.Windows.Forms.csproj" />
    <ProjectReference Include="..\ProGPU.Wpf\ProGPU.Wpf.csproj" />
  </ItemGroup>

  <Target Name="_ProGpuWpfRemoveNetCoreWindowsBaseFacade"
          BeforeTargets="ResolveAssemblyReferences"
          DependsOnTargets="ResolveTargetingPackAssets;ResolveLockFileReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(Reference.Filename)' == 'WindowsBase' And $([System.String]::Copy('%(Reference.RootDir)%(Reference.Directory)').Contains('microsoft.netcore.app.ref'))" />
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="'%(ReferencePath.Filename)' == 'WindowsBase' And $([System.String]::Copy('%(ReferencePath.RootDir)%(ReferencePath.Directory)').Contains('microsoft.netcore.app.ref'))" />
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)"
                                      Condition="'%(ReferencePathWithRefAssemblies.Filename)' == 'WindowsBase' And $([System.String]::Copy('%(ReferencePathWithRefAssemblies.RootDir)%(ReferencePathWithRefAssemblies.Directory)').Contains('microsoft.netcore.app.ref'))" />
    </ItemGroup>
  </Target>
</Project>
